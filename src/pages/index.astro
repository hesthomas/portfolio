---
import Layout from '../layouts/Layout.astro';
import mattiknew1 from '../assets/the-matthew-i-knew-1.jpg';

/* Data for each portfolio piece, including title, year, tags, and media links. This array is used to dynamically generate the project list on the homepage. */
// Portfolio project data drives the cards, media carousels, and project notes below.
const projects = [
	{ number: '01', title: 'The Matthew I Knew', kind: 'Interactive documentary game', year: '2026', tags: ['True-crime game', 'Graduate thesis'], video: 'https://youtu.be/P6OlBI2Bzb4', image: mattiknew1, intro: 'An investigative documentary game that explores the 1998 murder of Matthew Shepard through primary source documents, revealing documentary games\' potential for educating and evoking empathy.', body: `Key theoretical texts informing the methodology include Ian Bogost's Persuasive Games (2007) on procedural rhetoric in documentary games, Judith Butler's Frames of War (2009) on documentary ethics and representation, and Robyn Frances Higgins' "Speculative Documentarian Practices" (2025) on radial standpoint disclosure and continuous present temporality.`, meta: 'Python / UX Testing / AI Prototyping', className: 'feature' },
	{ number: '02', title: 'Homecoming', kind: 'Interactive installation', year: '2026', tags: ['Art installation', 'Speculative documentary'], video: 'https://youtube.com/shorts/RHr_rQ15bUE', image: 'https://i.ytimg.com/vi/RHr_rQ15bUE/maxresdefault.jpg', intro: 'An interactive art installation questioning how we memorialize and archive people.', body: `This installation is based on my grandfather's practice of memorializing the attendees of my childhood church. I studied his pencil drawn technique and recreated it digitally. I recreated this analogue approach to memorialization with real-time computer vision and machine learning to interrogate how contemporary memory-making technologies simultaneously honor and erase us—flattening identity while also allowing it to persist beyond our physical presence. Pose in front of this piece to create a numbered group photo, and scan the QR code to save your photo and preserve the record of your visit and the people you shared it with.`, meta: 'TouchDesigner / MediaPipe / Machine learning', className: 'installation' },
	{ number: '03', title: 'Gay For The Stay', kind: 'Dialogue game', year: '2025', tags: ['Art installation', 'Narrative design'], video: 'https://youtu.be/8vf0CIt02xE', image: 'https://i.ytimg.com/vi/8vf0CIt02xE/maxresdefault.jpg', intro: 'A prison video visitation system for talking with Oscar Wilde.', body: 'A physical, pixelated visual novel retells the last years of Wilde\'s life through a number pad interface. Research, writing, Arduino hardware, and Processing graphics meet in a small machine built for a very human conversation.', meta: 'Processing / Arduino / Twine / Physical computing', className: 'dialogue' },
	{ number: '04', title: 'BMW Mixed Reality', kind: 'Product design pitch', year: '2024', tags: ['Virtual reality', 'Client collaboration'], video: 'https://youtu.be/OJR6G9Dd7ns', videoCredit: 'Produced and directed by Bahar Rezvanifar, performed by myself and Lily Vengco in collaboration with the SCADpro x BMW Mixed Reality Experience team.', image: 'https://i.ytimg.com/vi/OJR6G9Dd7ns/maxresdefault.jpg', intro: 'An Apple Vision experience imagining how BMW shoppers might meet a car before they buy it.', body: 'In collaboration with SCADpro and BMW, I developed a headset prototype in Unity and presented our research and demos to stakeholders. Users explore life-size vehicles, inspect features, review stats, and step inside.', meta: 'Unity / Apple Vision Pro / Xcode', className: 'mixed-reality' },
	{ number: '05', title: 'Savannah: An Intelligent Grid', kind: 'Exhibit redesign', year: '2025', tags: ['Exhibition design', 'Primary research'], video: 'https://youtu.be/vOuCKAwofY0', videoCredit: 'Video created by Vihaan Kumar in collaboration with the SCAD Serve x Massie Heritage Museum team', image: 'https://i.ytimg.com/vi/vOuCKAwofY0/maxresdefault.jpg', intro: 'A proposed interactive exhibit that makes Savannah\'s city plan legible, alive, and worth lingering over.', body: 'For the Massie Heritage Museum, I conducted interviews with staff and visitors, studied successful history exhibits, and pitched a projection-mapped experience that turns urban planning into an explorable story.', meta: 'Figma / Photoshop / Participatory design', className: 'savannah' },
	{ number: '06', title: 'Out of Order', kind: 'Augmented reality exhibition', year: '2023', tags: ['AR', 'Auto-ethnography'], intro: 'A mixed-media exhibition about queerness, Christianity, and the glitches between identities.', body: 'Poster prints become portals through a phone camera. The Unity and Vuforia system layers animation onto physical works, creating a contrast between what is fixed on the wall and what refuses to stay still.', meta: 'Unity / Vuforia / Photoshop / Illustrator', className: 'out-of-order' },
];

// Convert standard YouTube and Shorts links into embeddable player URLs.
const getYouTubeEmbedUrl = (videoUrl: string) => {
	const url = new URL(videoUrl);
	const videoId = url.hostname === 'youtu.be'
		? url.pathname.slice(1)
		: url.pathname.startsWith('/shorts/')
			? url.pathname.split('/')[2]
			: url.searchParams.get('v');

	return `https://www.youtube.com/embed/${videoId}?controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1`;
};
---
<!-- Page shell and global navigation. -->
<Layout>
	<main>
		<!--Top header and navigation -->
        <nav class="nav shell" aria-label="Main navigation">
			<a class="wordmark" href="#top" aria-label="Thomas Walker home"><img src="/favicon.svg" alt="" /></a>
			<div class="nav-links"><a href="#work">Work</a><a href="/resume">Resume</a><a href="#about">About</a><a href="mailto:hesthomas@protonmail.com" class="nav-contact">Get in touch <span>↗</span></a></div>
			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu <span aria-hidden="true">+</span></button>
			<div class="mobile-menu" id="mobile-menu" hidden><a href="#work">Work</a><a href="/resume">Resume</a><a href="#about">About</a><a href="mailto:hesthomas@protonmail.com">Get in touch <span>↗</span></a></div>
		</nav>
		<!-- Hero introduction and positioning statement. -->
		<section class="hero shell" id="top">
			<div class="hero-bottom"><p class="hero-summary">Hi, I’m Thomas Walker—an interactive media and experience designer creating research-driven work across installations, games, digital products, and workflow systems.</p></div>
		</section>
		<!-- Project showcase generated from the projects array. -->
		<section class="work-section" id="work">
			<div class="shell section-heading"><p class="eyebrow">Selected work <span>({projects.length})</span></p></div>
			<div class="project-list shell">
				{projects.map((project) => (
					<article class={`project ${project.className}`}>
						<!-- Project media, credits, and markers. -->
						<div class="project-visual">
							{project.video && (
								<div class="video-frame">
									<iframe src={getYouTubeEmbedUrl(project.video)} title={`${project.title} video`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
									{project.videoCredit && <p class="video-credit">{project.videoCredit}</p>}
								</div>
							)}
							<span class="project-number">{project.number}</span>
							{project.className === 'out-of-order' && <span class="ar-mark">AR<br /><small>SCAN TO<br />REVEAL</small></span>}
							{project.className === 'installation' && <span class="frame-mark">◉ &nbsp; 4000+</span>}
							{project.className === 'dialogue' && <span class="keypad-mark">0&nbsp;&nbsp; 1&nbsp;&nbsp; 2<br />3&nbsp;&nbsp; 4&nbsp;&nbsp; 5</span>}
						</div>
						<div class="project-copy"><div class="project-topline"><span>{project.kind}</span><span>{project.year}</span></div><h2>{project.title}</h2><p class="project-intro">{project.intro}</p><div class="tag-row">{project.tags.map((tag) => <span>{tag}</span>)}</div><details><summary>Read project notes <span>+</span></summary><div class="details-content"><div class="details-inner"><p>{project.body}</p><p class="project-meta">{project.meta}</p></div></div></details></div>
					</article>
				))}
			</div>
		</section>
		<!-- About section and primary contact action. -->
		<section class="about shell" id="about"><div class="about-label"><p class="eyebrow">About</p></div><div class="about-copy"><p>I earned my B.S. in Computer Science with a focus on Game Development at Samford University and my M.F.A in Interactive Design at Savannah College of Art and Design (SCAD). I currently work freelance and live in Chattanooga, TN.</p><a class="nav-contact about-contact" href="mailto:hesthomas@protonmail.com">Get in touch <span>↗</span></a></div></section>
		<footer class="footer shell"><p>Thomas Walker <span>© 2026</span></p><div><a href="mailto:hesthomas@protonmail.com">Email</a><a href="https://www.linkedin.com/in/thomas-walker-247178142/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></footer>
	</main>
</Layout>

<!-- Global styles, responsive rules, and interaction states. -->
<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap');
	/* Shared palette tokens used by the page-wide color overrides below. */
	:root {
		--palette-paper: #f3eedf;
		--palette-ink: #252522;
		--palette-line: #cbc6b7;
		--palette-muted: #5e5a52;
		--palette-muted-light: #a8a49a;
		--palette-muted-dark: #9d9a8f;
		--palette-accent: #e84a2a;
		--palette-green: #61845c;
		--palette-green-dark: #5b8e62;
		--palette-green-pale: #d7e2d0;
		--palette-yellow: #f6b94e;
		--palette-project-base: #454844;
	}
	:global(*) { box-sizing: border-box; } :global(html) { scroll-behavior: smooth; } :global(body) { background: #f3eedf; color: #1c1c1a; font-family: 'DM Sans', sans-serif; } :global(a) { color: inherit; text-decoration: none; } :global(.shell) { width: min(1180px, calc(100% - 64px)); margin: 0 auto; } :global(main) { overflow: hidden; }
	.nav { height: 92px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #cbc6b7; } .wordmark { display: block; width: 34px; height: 34px; } .wordmark img { width: 150%; height: 150%; display: block; } .nav-links { display: flex; align-items: center; gap: 30px; font-family: 'DM Mono', monospace; font-size: 0.8rem; text-transform: uppercase; letter-spacing: .08em; } .nav-links a { opacity: .72; } .nav-links a:hover { opacity: 1; } .nav-contact { background: #1c1c1a; color: #f3eedf; padding: 11px 14px; opacity: 1 !important; } .nav-contact span { color: #61845C; margin-left: 10px; }
	.hero { padding: 100px 0 100px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; } .hero-kicker, .eyebrow, .project-topline, .tag-row, .project-meta, .footer { font-family: 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; } .hero-kicker { display: flex; align-items: center; gap: 9px; color: #5e5a52; } .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #5b8e62; box-shadow: 0 0 0 4px #d7e2d0; } h1, h2, p { margin: 0; } h1 { font-size: clamp(4.5rem, 10.5vw, 9.4rem); line-height: .87; letter-spacing: -.08em; font-weight: 500; max-width: 1000px; } em { font-family: 'Fraunces', serif; font-weight: 500; letter-spacing: -.07em; } .hero h1 em { color: #e84a2a; } .hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 0px; } .hero-summary { max-width: 420px; font-family: 'DM Sans', Arial, sans-serif; font-size: 1.3rem; line-height: 1.5; color: #5e5a52; } .scroll-cue, .text-link { font-family: 'DM Mono', monospace; text-transform: uppercase; font-size: .67rem; letter-spacing: .08em; } .scroll-cue span { color: #e84a2a; font-size: 1.25rem; vertical-align: -2px; margin-right: 8px; }
	.work-section { background: #1c1c1a; color: #f3eedf; padding: 100px 0 120px; } .section-heading { display: flex; justify-content: space-between; align-items: start; padding-bottom: 58px; } .eyebrow { color: #e84a2a; } .eyebrow span { color: #8b887d; } .section-note { color: #a8a49a; font-family: 'Fraunces', serif; font-size: 1.55rem; line-height: 1.12; text-align: right; } .project-list { display: grid; gap: 86px; } .project { display: grid; grid-template-columns: 1.08fr .92fr; gap: 7.5%; align-items: center; } .project:nth-child(even) { grid-template-columns: .92fr 1.08fr; } .project:nth-child(even) .project-visual { order: 2; } .project-visual { min-height: 430px; position: relative; overflow: hidden; background: #454844; isolation: isolate; } .project-visual img { width: 100%; height: 100%; min-height: 430px; display: block; object-fit: cover; mix-blend-mode: screen; opacity: .58; filter: saturate(.75) contrast(1.15); transition: transform .6s ease, opacity .3s ease; } .project:hover .project-visual img { transform: scale(1.035); opacity: .78; } .visual-overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(140deg, #b53c24, #272b28 60%, #5a693f); } .feature .visual-overlay { background: radial-gradient(circle at 80% 22%, #61845C 0 8%, transparent 9%), linear-gradient(135deg, #aa3f2c, #152c31 65%); } .installation .visual-overlay { background: radial-gradient(ellipse at 20% 80%, #61845C 0 7%, transparent 8%), linear-gradient(120deg, #516b64, #1f2829 65%); } .dialogue .visual-overlay { background: linear-gradient(135deg, #454e70, #13151a 68%); } .mixed-reality .visual-overlay { background: linear-gradient(135deg, #a7b4ae, #344740 55%, #d57044); } .savannah .visual-overlay { background: linear-gradient(135deg, #d27f48, #3c5a55 63%); } .out-of-order .visual-overlay { background: repeating-linear-gradient(90deg, #dc4934 0 15%, #61845C 15% 30%, #1d3438 30% 45%); } .project-number { position: absolute; top: 18px; left: 20px; color: #fff; font-family: 'DM Mono', monospace; font-size: .72rem; } .play-link { position: absolute; bottom: 20px; left: 20px; color: #fff; background: #1c1c1a; padding: 10px 12px; font-family: 'DM Mono', monospace; font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; } .play-link span { color: #61845C; margin-left: 14px; } .frame-mark { position: absolute; right: 20px; top: 20px; font-family: 'DM Mono', monospace; font-size: .65rem; color: #61845C; } .keypad-mark { position: absolute; right: 30px; bottom: 28px; font: 1.1rem 'DM Mono', monospace; color: #61845C; line-height: 1.7; } .ar-mark { position: absolute; right: 22px; top: 18px; font: 600 2rem 'DM Mono', monospace; color: #1c1c1a; line-height: .85; } .ar-mark small { font-size: .43rem; line-height: 1; letter-spacing: .05em; }
	.project-copy { align-self: center; } .project-topline { display: flex; justify-content: space-between; border-top: 1px solid #57564e; padding-top: 12px; color: #9d9a8f; } .project-topline span:first-child { color: #f6b94e; } .project h2 { font-size: clamp(2.5rem, 5vw, 5.2rem); letter-spacing: -.08em; line-height: .88; font-weight: 500; margin: 28px 0 23px; } .project-intro { font: 1.12rem/1.35 'Fraunces', serif; color: #dad6c9; max-width: 390px; } .tag-row { display: flex; flex-wrap: wrap; gap: 7px; margin: 28px 0 34px; } .tag-row span { border: 1px solid #57564e; padding: 7px 9px; color: #9d9a8f; } details { border-top: 1px solid #57564e; } summary { list-style: none; cursor: pointer; padding: 14px 0; font-family: 'DM Mono', monospace; text-transform: uppercase; font-size: .65rem; letter-spacing: .08em; color: #f3eedf; display: flex; justify-content: space-between; } summary::-webkit-details-marker { display: none; } summary span { color: #e84a2a; font-size: 1.15rem; line-height: .5; } .details-content { padding: 4px 0 20px; color: #a8a49a; font-size: .91rem; line-height: 1.5; } .project-meta { color: #f6b94e; margin-top: 18px; font-size: .61rem; }
	.about { display: grid; grid-template-columns: 1fr 2fr; gap: 7.5%; padding-top: 130px; padding-bottom: 150px; } .about-label { display: flex; flex-direction: column; justify-content: space-between; } .about-line { width: 100%; height: 1px; background: #cbc6b7; margin-bottom: 20px; } .about-copy h2 { font-size: clamp(3rem, 7vw, 7.3rem); line-height: .86; letter-spacing: -.08em; font-weight: 500; margin-bottom: 54px; } .about-copy h2 em { color: #e84a2a; } .about-copy > p { max-width: 575px; color: #5e5a52; line-height: 1.55; margin-bottom: 18px; font-size: 1.03rem; } .text-link { display: inline-block; margin-top: 30px; border-bottom: 1px solid #e84a2a; padding-bottom: 7px; } .text-link span { color: #e84a2a; margin-left: 12px; } .footer { border-top: 1px solid #cbc6b7; padding: 22px 0 35px; display: flex; justify-content: space-between; color: #5e5a52; } .footer p span { margin-left: 22px; color: #aaa599; } .footer div { display: flex; gap: 25px; }
	@media (max-width: 700px) { :global(.shell) { width: min(100% - 36px, 1180px); } .nav { height: 72px; } .nav-links { gap: 14px; } .nav-links a:not(.nav-contact) { display: none; } .nav-contact { padding: 9px 10px; } .hero { min-height: 620px; padding: 58px 0 70px; } h1 { font-size: clamp(4rem, 18vw, 7rem); } .hero-bottom, .section-heading, .footer { align-items: start; flex-direction: column; gap: 30px; } .scroll-cue { align-self: flex-end; } .section-note { text-align: left; } .work-section { padding: 70px 0 80px; } .project, .project:nth-child(even) { grid-template-columns: 1fr; gap: 28px; } .project:nth-child(even) .project-visual { order: initial; } .project-visual, .project-visual img { min-height: 300px; } .project h2 { margin: 20px 0; } .project-list { gap: 72px; } .about { grid-template-columns: 1fr; gap: 54px; padding-top: 85px; padding-bottom: 90px; } .about-line { display: none; } .about-copy h2 { margin-bottom: 38px; } .footer { gap: 18px; } }
	.nav { position: relative; }
	.menu-toggle, .mobile-menu { display: none; }
	@media (max-width: 700px) { .menu-toggle { display: inline-flex; align-items: center; gap: 8px; border: 0; background: transparent; color: var(--palette-ink); font: 500 .72rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; } .menu-toggle span { font-size: 1.2rem; line-height: .7; transition: transform .2s ease; } .menu-toggle[aria-expanded='true'] span { transform: rotate(45deg); } .mobile-menu { position: absolute; z-index: 10; top: calc(100% + 1px); left: 18px; right: 18px; display: grid; gap: 0; border: 1px solid var(--palette-line); background: var(--palette-paper); box-shadow: 4px 4px 0 var(--palette-accent); } .mobile-menu[hidden] { display: none; } .mobile-menu a { padding: 15px 16px; border-bottom: 1px solid var(--palette-line); font: 500 .75rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; } .mobile-menu a:last-child { border-bottom: 0; } .mobile-menu a:hover, .mobile-menu a:focus-visible { color: var(--palette-accent); } }
	.project-topline span:first-child, .project-meta { color: #61845C; }
	.nav-contact { font-family: 'DM Mono', monospace; font-size: 0.8rem; text-transform: uppercase; letter-spacing: .08em; }
	.nav-contact { display: inline-flex; align-items: center; transition: transform .2s ease, box-shadow .2s ease; }
	.nav-contact span { display: inline-block; margin-left: 10px; font-size: 1.25rem; line-height: .7; transition: transform .2s ease; }
	.nav-contact:hover, .nav-contact:focus-visible { transform: translateY(-2px); box-shadow: 4px 4px 0 var(--palette-accent); }
	.nav-contact:hover span, .nav-contact:focus-visible span { transform: translate(2px, -2px); }
	.about-contact { display: inline-block; margin-top: 24px; }
	.footer a { opacity: .72; transition: opacity .2s ease; }
	.footer a:hover, .footer a:focus-visible { opacity: 1; }
	.project-visual iframe { width: 100%; height: 100%; min-height: 430px; display: block; border: 0; }
	.video-credit { margin: 10px 14px 14px; color: var(--palette-muted-light); font: .68rem/1.35 'DM Mono', monospace; }
	.video-frame { position: relative; height: 100%; min-height: 430px; }
	@media (max-width: 700px) { .project-visual iframe, .video-frame { min-height: 300px; } }

	/* Change the variables above to recolor the page globally. */
	:global(body) { background: var(--palette-paper); color: var(--palette-ink); }
	.nav, .about-line, .footer { border-color: var(--palette-line); }
	.nav-contact, .work-section, .play-link { background-color: var(--palette-ink); }
	.nav-contact, .work-section { color: var(--palette-paper); }
	.nav-contact { color: var(--palette-paper); }
	.wordmark { position: relative; }
	.wordmark img { transition: transform .25s cubic-bezier(.22, 1, .36, 1); }
	.wordmark::before, .wordmark::after { position: absolute; z-index: 2; color: var(--palette-accent); opacity: 0; pointer-events: none; }
	.wordmark::before { content: '✦'; top: -11px; right: -9px; font-size: 12px; }
	.wordmark::after { content: '✦'; bottom: -9px; left: -10px; color: var(--palette-green); font-size: 9px; }
	.wordmark.is-celebrating img { animation: wordmark-pop .65s cubic-bezier(.22, 1, .36, 1); }
	.wordmark.is-celebrating::before, .wordmark.is-celebrating::after { animation: wordmark-spark .65s ease-out; }
	@keyframes wordmark-pop { 0% { transform: rotate(0) scale(1); } 45% { transform: rotate(12deg) scale(1.16); } 100% { transform: rotate(0) scale(1); } }
	@keyframes wordmark-spark { 0% { opacity: 0; transform: scale(.4) rotate(-20deg); } 35% { opacity: 1; transform: scale(1.2) rotate(12deg); } 100% { opacity: 0; transform: scale(.8) rotate(35deg); } }
	.hero-kicker, .hero-summary, .about-copy > p, .footer { color: var(--palette-muted); }
	.eyebrow, .hero h1 em, .about-copy h2 em, .scroll-cue span, .text-link, .text-link span, summary span { color: var(--palette-accent); }
	.status-dot { background: var(--palette-green-dark); box-shadow: 0 0 0 4px var(--palette-green-pale); }
	.nav-contact span, .play-link span, .frame-mark, .keypad-mark, .project-topline span:first-child, .project-meta { color: var(--palette-green); }
	.eyebrow span, .section-note, .details-content { color: var(--palette-muted-light); }
	.project-topline, .tag-row span, details { border-color: #57564e; }
	.project-topline, .tag-row span { color: var(--palette-muted-dark); }
	.project-intro { color: #dad6c9; }
	details .details-content { display: grid; grid-template-rows: 0fr; padding-top: 0; padding-bottom: 0; opacity: 0; overflow: hidden; transition: grid-template-rows .45s ease, opacity .3s ease, padding .45s ease; }
	details[open] .details-content { grid-template-rows: 1fr; padding-top: 4px; padding-bottom: 20px; opacity: 1; }
	.details-inner { min-height: 0; overflow: hidden; }
	summary span { display: inline-block; transition: transform .3s ease; }
	details[open] summary span { transform: rotate(45deg); }
	:global(::selection) { background: var(--palette-accent); color: var(--palette-paper); text-shadow: none; }
	:global(::-moz-selection) { background: var(--palette-accent); color: var(--palette-paper); text-shadow: none; }
	@media (hover: hover) and (pointer: fine) {
		:global(body) { cursor: url('/cursor.svg') 3 2, auto; }
		:global(a), :global(button), :global(summary) { cursor: url('/cursor.svg') 3 2, pointer; }
	}
</style>

<!-- Interactive behavior: wordmark celebration, carousel navigation, and details state remain native. -->
<script>
	const wordmark = document.querySelector<HTMLAnchorElement>('.wordmark');

	wordmark?.addEventListener('click', (event) => {
		event.preventDefault();
		wordmark.classList.remove('is-celebrating');
		void wordmark.offsetWidth;
		wordmark.classList.add('is-celebrating');
		window.setTimeout(() => wordmark.classList.remove('is-celebrating'), 700);
	});

	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');

	menuToggle?.addEventListener('click', () => {
		const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!isOpen));
		if (mobileMenu) mobileMenu.hidden = isOpen;
	});

	mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
		menuToggle?.setAttribute('aria-expanded', 'false');
		if (mobileMenu) mobileMenu.hidden = true;
	}));
</script>
